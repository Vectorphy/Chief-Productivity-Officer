# Discord Bot Credentials
# Replace with your actual Discord Bot Token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN="your_discord_bot_token_here"

# Discord User ID of the primary Bot Developer (for superadmin commands)
BOT_DEVELOPER_ID="123456789012345678"

# Optional Database & Runtime Settings
DB_NAME="bot_database.sqlite"
LOG_LEVEL="INFO"
